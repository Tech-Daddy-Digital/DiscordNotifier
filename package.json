{
  "name": "pulsedaddy-discord-bot",
  "version": "0.1.0",
  "description": "PulseDaddy: a Tech Daddy Digital Discord notification bot for creator and service alerts.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "npm run build && npm run test && npm run lint",
    "smoke:config": "tsx scripts/smoke-config.ts",
    "discord:register": "tsx src/discord/register-commands.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "pino": "^10.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
