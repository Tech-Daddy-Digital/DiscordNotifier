# Discord application credentials
# Create these at https://discord.com/developers/applications
DISCORD_TOKEN=replace-with-your-bot-token
DISCORD_CLIENT_ID=123456789012345678
# Optional but recommended while testing: commands update instantly in one server.
DISCORD_GUILD_ID=234567890123456789
# Default Discord text channel for placeholder notifications.
DISCORD_NOTIFICATION_CHANNEL_ID=345678901234567890

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# Optional shared secret for POST /notifications/placeholder.
# If set, callers must send: Authorization: Bearer this-value
NOTIFICATION_WEBHOOK_TOKEN=change-me-before-public-deploy

# Logging: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Set true to send a startup message to DISCORD_NOTIFICATION_CHANNEL_ID when the bot connects.
SEND_STARTUP_PLACEHOLDER_NOTIFICATION=false
